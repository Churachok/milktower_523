{
  "openapi": "3.1.0",
  "info": {
    "title": "Milk Tower — frontend/backend API",
    "version": "1.1.0",
    "description": "Implemented FastAPI/SQLite backend with synthetic demo sessions, role checks and HTTP ML scoring. Demo login is intended for synthetic data only."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/applications": {
      "get": {
        "summary": "List applications visible to current authenticated actor",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Application"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role or ownership denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Application not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State/version conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create client draft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "productId"
                ],
                "properties": {
                  "productId": {
                    "type": "string",
                    "enum": [
                      "working",
                      "equipment"
                    ]
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Optional calculator amount; validate against selected product limits."
                  },
                  "term": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Optional calculator term in months; validate against selected product limits."
                  },
                  "calculation": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/LoanCalculation"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role or ownership denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Application not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State/version conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/applications/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "summary": "Update a client-owned draft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role or ownership denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Application not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State/version conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove a client-owned draft",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role or ownership denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Application not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State/version conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/applications/{id}/actions": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Apply state transition authorized by server session",
        "description": "submitted: client draft or needs_info with reply; manual_review: employee after checks; needs_info/rejected: reason required; approved: amount/term/rate; issued: accepted=true. Server must enforce role, ownership, transition and idempotency.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Action"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role or ownership denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Application not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State/version conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/applications/{id}/documents": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Upload document and return updated application",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "kind"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "statement",
                      "report",
                      "additional",
                      "other"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "413": {
            "description": "File over 10 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported file type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role or ownership denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Application not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State/version conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/applications/{id}/documents/{documentId}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "documentId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "delete": {
        "summary": "Remove document from draft or needs_info application",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Role or ownership denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Application not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State/version conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/session": {
      "get": {
        "summary": "Get the current server-authenticated role",
        "responses": {
          "200": {
            "description": "Session exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "role"
                  ],
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": [
                        "client",
                        "employee"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "delete": {
        "summary": "Invalidate server session and clear session cookie",
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      },
      "post": {
        "summary": "Create a synthetic server session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "login"
                ],
                "properties": {
                  "login": {
                    "type": "string",
                    "enum": [
                      "volkov",
                      "smirnova",
                      "ivanova"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HttpOnly session cookie and authenticated role",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "role"
                  ],
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": [
                        "client",
                        "employee"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Demo login disabled or unknown user"
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "Identify the release and exact source commit",
        "security": [],
        "responses": {
          "200": {
            "description": "Public synthetic build metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "version",
                    "commit",
                    "mode"
                  ],
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "commit": {
                      "type": "string"
                    },
                    "mode": {
                      "const": "synthetic-demo"
                    },
                    "scoring": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "Placeholder name to agree with backend. HttpOnly, Secure, SameSite and CSRF policy enforced server-side."
      }
    },
    "schemas": {
      "Company": {
        "type": "object",
        "required": [
          "name",
          "inn",
          "industry",
          "contact",
          "email",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "industry": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "inn": {
            "type": "string",
            "pattern": "^(?:[0-9]{10}|[0-9]{12})$"
          }
        }
      },
      "Finances": {
        "type": "object",
        "required": [
          "revenue",
          "expenses",
          "debt",
          "years"
        ],
        "properties": {
          "revenue": {
            "type": "number",
            "minimum": 0
          },
          "expenses": {
            "type": "number",
            "minimum": 0
          },
          "debt": {
            "type": "number",
            "minimum": 0
          },
          "years": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Application": {
        "type": "object",
        "required": [
          "id",
          "productId",
          "status",
          "amount",
          "term",
          "purpose",
          "company",
          "finances",
          "documents",
          "history",
          "messages",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "productId": {
            "type": "string",
            "enum": [
              "working",
              "equipment"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "submitted",
              "manual_review",
              "needs_info",
              "approved",
              "rejected",
              "issued"
            ]
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "term": {
            "type": "integer",
            "minimum": 1
          },
          "purpose": {
            "type": "string"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "finances": {
            "$ref": "#/components/schemas/Finances"
          },
          "consent": {
            "type": "boolean"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryEvent"
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "checks": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Checks"
              },
              {
                "type": "null"
              }
            ]
          },
          "request": {
            "type": [
              "string",
              "null"
            ]
          },
          "offer": {
            "$ref": "#/components/schemas/Offer"
          },
          "rejectionReason": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "calculation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LoanCalculation"
              },
              {
                "type": "null"
              }
            ]
          },
          "scoringResult": {
            "type": [
              "object",
              "null"
            ],
            "description": "Persisted ML response: decision, message, approved_amount, checks, features and assumptions. Cleared when resubmitted after clarification.",
            "additionalProperties": true
          }
        }
      },
      "DraftUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "productId": {
            "type": "string",
            "enum": [
              "working",
              "equipment"
            ]
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "term": {
            "type": "integer",
            "minimum": 1
          },
          "purpose": {
            "type": "string"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "finances": {
            "$ref": "#/components/schemas/Finances"
          },
          "consent": {
            "type": "boolean"
          },
          "calculation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LoanCalculation"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
          "id",
          "name",
          "size",
          "kind",
          "uploadedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "statement",
              "report",
              "additional",
              "other"
            ]
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "demo": {
            "type": "boolean"
          }
        }
      },
      "HistoryEvent": {
        "type": "object",
        "required": [
          "id",
          "title",
          "detail",
          "actor",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "id",
          "text",
          "actor",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      },
      "Offer": {
        "type": "object",
        "required": [
          "amount",
          "term",
          "rate",
          "expiresAt"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "term": {
            "type": "integer"
          },
          "rate": {
            "type": "number",
            "minimum": 0
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Checks": {
        "type": "object",
        "required": [
          "score",
          "rating",
          "recommendation",
          "factors"
        ],
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "rating": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "factors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "positive"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "positive": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "Action": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "submitted",
              "manual_review",
              "needs_info",
              "approved",
              "rejected",
              "issued"
            ]
          },
          "reason": {
            "type": "string"
          },
          "reply": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "term": {
            "type": "integer"
          },
          "rate": {
            "type": "number",
            "minimum": 0
          },
          "accepted": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "LoanCalculation": {
        "type": "object",
        "description": "Preliminary UI estimate snapshot, not a bank offer or underwriting result. Server must validate or recompute; preserve the snapshot after submission for comparison. Monetary amounts in RUB, rate in annual percent.",
        "required": [
          "amount",
          "term",
          "rate",
          "monthlyPayment",
          "totalPayment",
          "overpayment"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "term": {
            "type": "integer",
            "minimum": 1
          },
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "monthlyPayment": {
            "type": "number",
            "minimum": 0
          },
          "totalPayment": {
            "type": "number",
            "minimum": 0
          },
          "overpayment": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
